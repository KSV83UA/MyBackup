<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>MyBackup.Web</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MyBackup.Web.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MyBackup.Core\MyBackup.Core.csproj" />
